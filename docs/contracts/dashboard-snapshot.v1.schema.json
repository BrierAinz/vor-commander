{
  "$defs": {
    "DeviceStatus": {
      "oneOf": [
        {
          "const": "connected",
          "description": "Holds an authenticated transport link to this gateway right now.",
          "type": "string"
        },
        {
          "const": "not_connected",
          "description": "Paired and not revoked, but no transport link to this gateway right now.",
          "type": "string"
        },
        {
          "const": "revoked",
          "description": "Revoked in the tenant store. Takes precedence over any transport state.",
          "type": "string"
        }
      ]
    },
    "DeviceView": {
      "additionalProperties": false,
      "properties": {
        "agent_version": {
          "$ref": "#/$defs/Observed"
        },
        "capabilities": {
          "$ref": "#/$defs/Observed5"
        },
        "device_id": {
          "description": "Structural key; provenance follows the snapshot `mode`.",
          "type": "string"
        },
        "display_name": {
          "$ref": "#/$defs/Observed"
        },
        "last_seen_unix_ms": {
          "$ref": "#/$defs/Observed6"
        },
        "os": {
          "$ref": "#/$defs/Observed"
        },
        "status": {
          "$ref": "#/$defs/Observed4"
        },
        "workspace_ids": {
          "description": "Structural keys; provenance follows the snapshot `mode`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "device_id",
        "workspace_ids",
        "status",
        "display_name",
        "os",
        "agent_version",
        "capabilities",
        "last_seen_unix_ms"
      ],
      "type": "object"
    },
    "Observed": {
      "description": "An observable value together with its provenance.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "observed_at_unix_ms": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "provenance": {
              "const": "live",
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "provenance",
            "value",
            "observed_at_unix_ms"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "provenance": {
              "const": "unknown",
              "type": "string"
            },
            "reason": {
              "$ref": "#/$defs/UnknownReason"
            }
          },
          "required": [
            "provenance",
            "reason"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "provenance": {
              "const": "simulated",
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "provenance",
            "value"
          ],
          "type": "object"
        }
      ]
    },
    "Observed2": {
      "description": "An observable value together with its provenance.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "observed_at_unix_ms": {
              "format": "uint64",
